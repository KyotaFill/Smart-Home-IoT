    [ "servo:V+", "esp:5V", "red", [ "v0" ] ],
    [ "servo:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "servo:PWM", "esp:18", "orange", [ "v0" ] ],

    [ "buzzer:2", "esp:5", "purple", [ "v0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "v0" ] ]
