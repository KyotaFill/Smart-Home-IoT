{
  "version": 1,
  "author": "Antigravity",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -80, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 80, "left": 150, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": 150, "attrs": { "value": "220" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 180, "left": 150, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo", "top": -80, "left": -200, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 80, "left": -150, "attrs": {} }
