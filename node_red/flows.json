    {
        "id": "function_split",
        "type": "function",
        "z": "flow_1",
        "name": "Tách Data & Cảnh Báo",
        "func": "var msgTemp = { payload: msg.payload.temperature, topic: \"Nhiệt Độ\" };\nvar msgHum = { payload: msg.payload.humidity, topic: \"Độ Ẩm\" };\nvar msgLight = { payload: msg.payload.light, topic: \"Ánh Sáng\" };\n\nvar msgBuzzer = null;\nvar msgAlert = null;\n\n// Logic Tự động hóa: Cảnh báo nhiệt độ > 35\nif (msg.payload.temperature > 35) {\n    msgBuzzer = { payload: \"ON\", topic: \"iot/myhome_999/buzzer/control\" };\n    msgAlert = { payload: \"CẢNH BÁO: Nhiệt độ quá nóng (>35°C)!\" };\n} else {\n    msgBuzzer = { payload: \"OFF\", topic: \"iot/myhome_999/buzzer/control\" };\n}\n\nreturn [msgTemp, msgHum, msgLight, msgBuzzer, msgAlert];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "x": 440,
        "y": 140,
        "wires": [
            [
                "gauge_temp",
                "chart_all"
            ],
            [
                "gauge_hum",
                "chart_all"
            ],
            [
                "gauge_light"
            ],
            [
                "mqtt_out_buzzer"
            ],
            [
                "toast_alert"
            ]
        ]
    },
